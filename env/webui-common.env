# =============================================================================
# Open WebUI – centralized environment configuration
# =============================================================================
# Used by:
#   compose.yaml          – env_file: [./env/webui-common.env]
#   seed/start-seed.sh    – podman run --env-file
#
# Platform URL overrides (OPENAI_API_BASE_URL, RAG_OPENAI_API_BASE_URL,
# RAG_EXTERNAL_RERANKER_URL) are defined here with mac/host defaults and
# overridden per-platform in compose.nvidia.yaml / compose.amd.yaml.
#
# -----------------------------------------------------------------------------
# NOTE ON PersistentConfig VARIABLES
# Variables marked [PersistentConfig] below are normally persisted to
# webui.db on first run, after which env vars are ignored.
#
# ENABLE_PERSISTENT_CONFIG=False (set below) disables that behaviour so env
# vars always take precedence.  This is required so that platform URL
# overrides in compose.nvidia.yaml / compose.amd.yaml actually take effect
# on a container that already has a seeded database.
#
# Side-effect: settings changed in the Admin UI do NOT survive a restart.
# For managed demos where this file is the source of truth, that is fine.
# =============================================================================


# ── Config persistence ───────────────────────────────────────────────────────
# [non-PersistentConfig] Must come first.  Forces all PersistentConfig vars
# below to be read from the environment on every restart instead of the DB.
ENABLE_PERSISTENT_CONFIG=False

# ── Auth ─────────────────────────────────────────────────────────────────────
# [PersistentConfig] Effective on every restart because of the setting above.
WEBUI_AUTH=false
WEBUI_ADMIN_EMAIL=admin@localhost
WEBUI_ADMIN_PASSWORD=admin


# ── Offline / auto-update guards ─────────────────────────────────────────────
# [non-PersistentConfig] Re-applied on every restart.
OFFLINE_MODE=true
HF_HUB_OFFLINE=1
RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
RAG_RERANKING_MODEL_AUTO_UPDATE=false
WHISPER_MODEL_AUTO_UPDATE=false


# ── LLM connection ────────────────────────────────────────────────────────────
# [PersistentConfig] Mac/host default – overridden to container DNS names in
# compose.nvidia.yaml and compose.amd.yaml.
OPENAI_API_BASE_URL=http://host.containers.internal:8000/v1
OPENAI_API_KEY=not-needed

# Disable the Ollama sidebar so only the OpenAI-compatible endpoint is shown.
# [PersistentConfig]
ENABLE_OLLAMA_API=False


# ── Embeddings ────────────────────────────────────────────────────────────────
# [PersistentConfig] Mac/host default – overridden in overlay compose files.
RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL=http://host.containers.internal:8001/v1
RAG_OPENAI_API_KEY=not-needed
RAG_EMBEDDING_MODEL=nomic-embed-text-v1.5.Q8_0.gguf

# nomic-embed-text requires task-specific prefixes.
# [non-PersistentConfig] Trailing space is intentional – it joins the prefix
# word to the content with a single space (e.g. "search_document: my text").
RAG_EMBEDDING_CONTENT_PREFIX="search_document: "
RAG_EMBEDDING_QUERY_PREFIX="search_query: "
# Batch 16 chunks per embedding API call to reduce round-trips during bulk
# ingest.  llama.cpp's /v1/embeddings supports batched input.
# [PersistentConfig]
RAG_EMBEDDING_BATCH_SIZE=16


# ── Reranker ─────────────────────────────────────────────────────────────────
# [PersistentConfig]
# IMPORTANT: RAG_EXTERNAL_RERANKER_URL must be the FULL URL including the
# endpoint path.  Open WebUI does not append /v1/rerank automatically.
RAG_RERANKING_ENGINE=external
RAG_RERANKING_MODEL=bge-reranker-v2-m3-Q8_0.gguf
RAG_EXTERNAL_RERANKER_URL=http://host.containers.internal:8002/v1/rerank


# ── RAG retrieval tuning ──────────────────────────────────────────────────────
# [PersistentConfig]
# TOP_K controls the dense and BM25 candidate pools. TOP_K_RERANKER retains
# enough evidence to answer multi-step SST questions without flooding the
# 8K-token model context. Keep low-scoring candidates available to the model;
# the answer-outcome filter checks the native score of sources the answer
# actually cites.
RAG_TOP_K=16
RAG_TOP_K_RERANKER=8
RAG_RELEVANCE_THRESHOLD=-10.0

# Inject RAG context into the system message so KV-cache prefix caching works.
# [non-PersistentConfig]
RAG_SYSTEM_CONTEXT=True


# ── Chunking ─────────────────────────────────────────────────────────────────
# [PersistentConfig]
# 512-token chunks with 50-token overlap prevents mid-sentence boundary splits.
# ENABLE_MARKDOWN_HEADER_TEXT_SPLITTER is the default (True) but must be explicit
# here because CHUNK_MIN_SIZE_TARGET depends on it to merge orphan fragments.
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_MIN_SIZE_TARGET=100
ENABLE_MARKDOWN_HEADER_TEXT_SPLITTER=True


# ── Hybrid search ─────────────────────────────────────────────────────────────
# [PersistentConfig]
# The demo image paginates Open WebUI's full-collection Chroma read so BM25
# remains safe for the complete SST source corpus. Repository-relative paths
# are included in indexed text and enriched BM25 metadata.
ENABLE_RAG_HYBRID_SEARCH=True
RAG_HYBRID_BM25_WEIGHT=0.4
ENABLE_RAG_HYBRID_SEARCH_ENRICHED_TEXTS=True


# ── Grounded generation template ──────────────────────────────────────────────
# [PersistentConfig]
# RAG_TEMPLATE and QUERY_GENERATION_PROMPT_TEMPLATE live in separate text files
# for readability. The launch and refresh scripts pass them as environment
# variables; do not duplicate the multiline values here.
ENABLE_RETRIEVAL_QUERY_GENERATION=True
