# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and set PLATFORM before running start.sh
# ─────────────────────────────────────────────────────────────────────────────
#
#   mac    – llama-server runs natively on the host with Metal (GPU access
#            is impossible inside a Linux container on macOS)
#            Requires: llama.cpp built locally (run install-llama.sh)
#
#   nvidia – llama-server runs in containers with NVIDIA CUDA GPU passthrough
#            Requires: nvidia-container-toolkit
#
#   amd    – llama-server runs in containers with AMD ROCm GPU passthrough
#            Requires: ROCm installed, user in 'video' and 'render' groups
#
# ─────────────────────────────────────────────────────────────────────────────
PLATFORM=mac

# ─────────────────────────────────────────────────────────────────────────────
# DEMO_IMAGE – Open WebUI image to use.
#
# Downloadable releases set this to a versioned registry image. If it is left
# commented, start.sh uses the local developer tag and can build it from seed/
# when generated seed data is available.
#
#   DEMO_IMAGE=ghcr.io/hpc-ai-adv-dev/sst-ai-docops:v0.1.0
#
# ─────────────────────────────────────────────────────────────────────────────
DEMO_IMAGE=ghcr.io/hpc-ai-adv-dev/sst-ai-docops:v0.1.0

# Optional: use an isolated runtime directory without deleting existing chats.
#RUNTIME_DATA_DIR=./runtime-data-clean
